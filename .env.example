# Copy this file to .env and fill in your secrets
# Chat completions → Gemini (free tier, 1500 req/day per key)
# To get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEY=fallback_single_key
GEMINI_MODEL=gemini-2.5-flash-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Embeddings → OpenRouter (NVIDIA Nemotron model)
OPENROUTER_API_KEYS=sk-or-v1-xxx,sk-or-v1-yyy
OPENROUTER_API_KEY=sk-or-v1-fallback
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
LLM_MODEL=gemini-2.5-flash-001

JWT_SECRET=run_openssl_rand_-hex_32_or_python3_-c_import_secrets\;print(secrets.token_hex(32))

CHROMA_PATH=./chroma_db
RAG_TOP_K=5
BASE_STORAGE_DIR=./storage
